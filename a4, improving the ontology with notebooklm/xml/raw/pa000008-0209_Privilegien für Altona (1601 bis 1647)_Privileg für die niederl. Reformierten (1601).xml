   <text>
      <body>
         <div>
            <p facs="#facs_1_TextRegion_1699268146324_45">
                    <pb facs="#facs_1" xml:id="img_0001" n="1"/>
               <lb facs="#facs_1_tr_2_tl_1" n="N001"/>Der wolgebornner Graff unndt Herr, Herr <rs type="person" ref="#ernst_schaumburg_holstein">Ernnst</rs> Grave
               <lb facs="#facs_1_tr_2_tl_2" n="N002"/>zue <rs type="place" ref="#holstein_grafschaft">Hollstein</rs>, <rs type="place" ref="#schaumburg_grafschaft">Schaumburgk</rs>, unndt <rs type="place" ref="#sternberg_grafschaft">Sternnbergk</rs>, Herr zue <rs type="place" ref="#gehmen_herrschaft">
                        <w>Geh<pc>-</pc>
               <lb facs="#facs_1_tr_2_tl_3" n="N003"/>men</w>
                    </rs>, sagt den <rs type="place" ref="#niederlande_vereinigte">Niderlendischen</rs> Abgesannden <rs type="person" ref="#staes_petrus">Doctori Petro Staes</rs>,
               <lb facs="#facs_1_tr_2_tl_4" n="N004"/>
                    <rs type="person" ref="#bene_wilhelm">Wilhelm Bene</rs>, <rs type="person" ref="#fontein_jacob">Jacob Fontein</rs> unndt <rs type="person" ref="#werdt_gerdt">Gerdt die Werdt</rs> hiemit
               <lb facs="#facs_1_tr_2_tl_5" n="N005"/>in gnaden zu, wenn S<am>.</am>
                    <ex>eine</ex> G<am>.</am>
                    <ex>naden</ex> eine wichtige sache den abgesanndten
               <lb facs="#facs_1_tr_2_tl_6" n="N006"/>namkundig gemachtt unndt bewist hat richtig gemacht,
               <lb facs="#facs_1_tr_2_tl_7" n="N007"/>das sich I<am>.</am>
                    <ex>hre</ex> G<am>.</am>
                    <ex>naden</ex> mit besonndern fleiße will anngelegen sein laßen,
               <lb facs="#facs_1_tr_2_tl_8" n="N008"/>gleichwol schwerlich innerhalb den nechstenn neun oder zehen <w>Mo<pc>-</pc>
               <lb facs="#facs_1_tr_2_tl_9" n="N009"/>naten</w> wirdt verrichten konnen, das I<am>.</am>
                    <ex>hre</ex> G<am>.</am>
                    <ex>naden</ex> alsdann ermeldten<note type="annotation">genannten.</note>
               <lb facs="#facs_1_tr_2_tl_10" n="N010"/>Abgesanndten unndt iren consorten<note type="annotation">Gefährten, Genossen.</note> das exercitium reformata
               <lb facs="#facs_1_tr_2_tl_11" n="N011"/>religionis<note type="annotation">die Ausübung der reformierten Religion.</note> zu <rs type="place" ref="#altona">Altenahe</rs> auff maße unndt fleiße wie es zwischen
               <lb facs="#facs_1_tr_2_tl_12" n="N012"/>S<am>.</am>
                    <ex>einer</ex> G<am>.</am>
                    <ex>naden</ex> unndt Ihnen, den Abgesandtenn, den <date when="1601-10-23">drei unndt zwanzigsten
                  <lb facs="#facs_1_tr_2_tl_13" n="N013"/>dieses Monats octobris</date> abgeredt,<note type="annotation">Vgl. den <ref type="quelle" target="0218#">Text vom 28. Oktober 1601</ref> und die <ref type="einleitung" target="0216#verhandlungen_reformierte">Einleitung</ref>.</note> unndt ferrer in I<am>.</am>
                    <ex>hrer</ex> G<am>.</am>
                    <ex>naden</ex> <w>an<pc>-</pc>
               <lb facs="#facs_1_tr_2_tl_14" n="N014"/>kunfft</w> in I<am>.</am>
                    <ex>hrer</ex> G<am>.</am>
                    <ex>naden</ex> <rs type="place" ref="#holstein_grafschaft">Graveschafft Hollstein</rs> in kunfftigen <w>frue<pc>-</pc>
               <lb facs="#facs_1_tr_2_tl_15" n="N015"/>linng</w> (den abgeredten Puncten unnachteilich) so viel die onera
               <lb facs="#facs_1_tr_2_tl_16" n="N016"/>subditorum<note type="annotation">Abgaben der Untertanen.</note> unndt anndere politica<note type="annotation">öffentliche Angelegenheiten.</note> ahnlannget, vergleicht
               <lb facs="#facs_1_tr_2_tl_17" n="N017"/>werdten soll, gnedig concediret, unndt nachgibtt, doch soll
               <lb facs="#facs_1_tr_2_tl_18" n="N018"/>dießes zwischen I<am>.</am>
                    <ex>hrer</ex> G<am>.</am>
                    <ex>naden</ex> unndt Ihnen in mittlerweil in eußerster
               <lb facs="#facs_1_tr_2_tl_19" n="N019"/>geheimb bewuster Uhrsachen halber gehaltten werdten,
               <lb facs="#facs_1_tr_2_tl_20" n="N020"/>das die Abgesanndten fur sich unndt Ire Consorten bey ehren
               <lb facs="#facs_1_tr_2_tl_21" n="N021"/>unndt treuen zugesagtt.</p>
                <p resp="CVG">Des zue Uhrkunndtt I<am>.</am>
                    <ex>hre</ex> G<am>.</am>
                    <ex>naden</ex>
               <lb facs="#facs_1_tr_2_tl_22" n="N022"/>dieses mitt eigener hanndt underschrieben, unndt mitt I<am>.</am>
                    <ex>hrer</ex> G<am>.</am>
                    <ex>naden</ex>
               <lb facs="#facs_1_tr_2_tl_23" n="N023"/>secret<note type="annotation">Kleines Siegel.</note> versiegeltt hatt. Actum auff Ih<am>.</am>
                    <ex>rer</ex> G<am>.</am>
                    <ex>naden</ex>
               <lb facs="#facs_1_tr_2_tl_24" n="N024"/>Hauß <rs type="place" ref="#stadthagen">Statthagen</rs> denn <date when="1601-10-27">sieben unndt zwantzigsten tagh
               <lb facs="#facs_1_tr_2_tl_25" n="N025"/>octobris Anno Sechtzehennhundertt unndt eins</date>.
            </p>
            <p facs="#facs_1_region_1703266388508_969">
               <lb facs="#facs_1_line_1703266439613_978" n="N001"/>
                    <rs type="person" ref="#ernst_schaumburg_holstein">Ernst</rs>
            </p>

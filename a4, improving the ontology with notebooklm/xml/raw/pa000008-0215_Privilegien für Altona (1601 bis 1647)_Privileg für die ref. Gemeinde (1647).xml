            <zone points="2683,4039 2817,3993 3014,4034 3232,4003 3299,3982 3304,3853 3159,3832 3066,3755 2828,3760 2771,3708 2745,3724 2693,3703" rendition="Line" xml:id="facs_1_tr_1_tl_63"/>
